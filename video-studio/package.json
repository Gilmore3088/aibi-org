{
  "name": "aibi-video-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Remotion project for programmatically generating aibi videos (starting with the AI-readiness assessment results explainer). Independent of the Next.js app.",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render src/index.ts AssessmentResults out/assessment-results.mp4",
    "render-props": "remotion render src/index.ts AssessmentResults out/custom.mp4 --props=./props.json",
    "render-explainer": "remotion render src/index.ts AiReadyExplainer out/whats-ai-ready.mp4",
    "render-ad": "remotion render src/index.ts BlankCursor out/blank-cursor.mp4",
    "voiceover": "tsx scripts/generate-voiceover.ts",
    "still": "remotion still src/index.ts AssessmentResults out/frame.png --frame=300",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.440",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.440"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "undici": "^6.21.0"
  }
}
