{
  "name": "aibi-walkthrough",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render src/index.ts SiteWalkthrough out/site-walkthrough.mp4",
    "render-ad": "remotion render src/index.ts AssessmentAd out/assessment-ad.mp4 --crf 28",
    "voiceover": "tsx scripts/generate-voiceover.ts",
    "record": "node scripts/record-experience.mjs && npx remotion ffmpeg -y -i public/footage/_rec/assessment.webm -c:v libx264 -crf 24 -pix_fmt yuv420p -movflags +faststart public/footage/assessment.mp4"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.440",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.440"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "undici": "^6.21.0"
  }
}
