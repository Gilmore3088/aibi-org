{
  "name": "aibi-scaffold",
  "version": "0.1.0",
  "private": true,
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "**/globals.css",
    "src/styles/**",
    "src/middleware.ts"
  ],
  "scripts": {
    "predev": "node scripts/sync-sandbox-data.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-sandbox-data.mjs",
    "build": "next build",
    "sync:sandbox-data": "node scripts/sync-sandbox-data.mjs",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:persona-wave": "node e2e/persona-wave/run-wave.mjs",
    "e2e:ui": "playwright test --ui",
    "e2e:smoke": "playwright test e2e/smoke.spec.ts",
    "e2e:a11y": "playwright test e2e/a11y.spec.ts",
    "audit:env": "node scripts/audit-env.mjs",
    "audit:env:strict": "node scripts/audit-env.mjs --strict",
    "audit:env:production": "node scripts/audit-env.mjs --strict --production",
    "audit:resources": "node scripts/audit-free-resources.mjs",
    "generate:templates": "tsx scripts/generate-template-pdfs.ts",
    "generate:prompt-cards": "esbuild scripts/generate-prompt-cards-pdf.tsx --bundle --platform=node --format=esm --packages=external --jsx=automatic --log-level=warning --outfile=node_modules/.cache/aibi/prompt-cards.mjs && node node_modules/.cache/aibi/prompt-cards.mjs",
    "generate:skill-library": "esbuild scripts/generate-skill-template-library.tsx --bundle --platform=node --format=esm --packages=external --jsx=automatic --log-level=warning --outfile=node_modules/.cache/aibi/skill-library.mjs && node node_modules/.cache/aibi/skill-library.mjs",
    "generate:large-print-resources": "node scripts/generate-large-print-resource-pdfs.mjs",
    "audit:secrets": "node scripts/scan-secrets.mjs",
    "check:course-schema": "node scripts/check-course-schema.mjs",
    "check:course-schema:strict": "node scripts/check-course-schema.mjs --strict",
    "e2e:install": "playwright install --with-deps chromium webkit",
    "hubspot:create-properties": "node scripts/hubspot-create-properties.mjs",
    "hubspot:create-properties:dry": "node scripts/hubspot-create-properties.mjs --dry-run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@google/generative-ai": "^0.24.1",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.0",
    "@react-pdf/renderer": "^4.9.0",
    "@sparticuz/chromium": "^153.0.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@types/mdx": "^2.0.14",
    "@vercel/analytics": "^2.0.1",
    "geist": "^1.7.2",
    "next": "15.5.27",
    "openai": "^7.31.0",
    "puppeteer-core": "^25.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@mdx-js/rollup": "^3.1.1",
    "@next/bundle-analyzer": "^16.4.0",
    "@playwright/test": "^1.64.0",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/ui": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "jsdom": "^30.1.2",
    "marked": "^18.1.0",
    "postcss": "^8.5.29",
    "satori": "^0.44.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "postcss": "$postcss",
    "undici": "^7.30.0",
    "sharp": "^0.35.4",
    "postcss-selector-parser": "^7.1.6"
  }
}
