{
  "name": "aibi-scaffold",
  "version": "0.1.0",
  "private": true,
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "**/globals.css",
    "src/styles/**",
    "src/middleware.ts"
  ],
  "scripts": {
    "predev": "node scripts/sync-sandbox-data.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-sandbox-data.mjs",
    "build": "next build",
    "sync:sandbox-data": "node scripts/sync-sandbox-data.mjs",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:course-preview": "E2E_COURSE_PREVIEW=true playwright test e2e/course-modules.spec.ts --grep 'local course preview'",
    "e2e:ui": "playwright test --ui",
    "e2e:smoke": "playwright test e2e/smoke.spec.ts",
    "e2e:a11y": "playwright test e2e/a11y.spec.ts",
    "audit:env": "node scripts/audit-env.mjs",
    "audit:env:strict": "node scripts/audit-env.mjs --strict",
    "audit:env:production": "node scripts/audit-env.mjs --strict --production",
    "audit:resources": "node scripts/audit-free-resources.mjs",
    "generate:templates": "tsx scripts/generate-template-pdfs.ts",
    "generate:large-print-resources": "node scripts/generate-large-print-resource-pdfs.mjs",
    "audit:secrets": "node scripts/scan-secrets.mjs",
    "check:course-schema": "node scripts/check-course-schema.mjs",
    "check:course-schema:strict": "node scripts/check-course-schema.mjs --strict",
    "e2e:install": "playwright install --with-deps chromium webkit",
    "hubspot:create-properties": "node scripts/hubspot-create-properties.mjs",
    "hubspot:create-properties:dry": "node scripts/hubspot-create-properties.mjs --dry-run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@google/generative-ai": "^0.24.1",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "15.5.23",
    "@react-pdf/renderer": "^4.5.1",
    "@sparticuz/chromium": "^149.0.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.107.0",
    "@types/mdx": "^2.0.14",
    "@vercel/analytics": "^2.0.1",
    "geist": "^1.7.2",
    "next": "15.5.23",
    "openai": "^6.44.0",
    "puppeteer-core": "^25.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/eslintrc": "3.3.6",
    "@next/bundle-analyzer": "15.5.23",
    "@playwright/test": "^1.62.1",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/ui": "^4.1.10",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.23",
    "jsdom": "^29.1.1",
    "marked": "^18.0.9",
    "postcss": "8.5.26",
    "satori": "^0.29.0",
    "tailwindcss": "^3.4.1",
    "tsx": "4.23.11",
    "typescript": "^5",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.3",
    "undici": "^7.29.0"
  }
}
