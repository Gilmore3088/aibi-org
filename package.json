{
  "name": "aibi-scaffold",
  "version": "0.1.0",
  "private": true,
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "**/globals.css",
    "src/styles/**",
    "src/middleware.ts"
  ],
  "scripts": {
    "predev": "node scripts/sync-sandbox-data.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-sandbox-data.mjs",
    "build": "next build",
    "sync:sandbox-data": "node scripts/sync-sandbox-data.mjs",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:smoke": "playwright test e2e/smoke.spec.ts",
    "e2e:a11y": "playwright test e2e/a11y.spec.ts",
    "audit:env": "node scripts/audit-env.mjs",
    "audit:env:strict": "node scripts/audit-env.mjs --strict",
    "check:course-schema": "node scripts/check-course-schema.mjs",
    "check:course-schema:strict": "node scripts/check-course-schema.mjs --strict",
    "e2e:install": "playwright install --with-deps chromium webkit",
    "hubspot:create-properties": "node scripts/hubspot-create-properties.mjs",
    "hubspot:create-properties:dry": "node scripts/hubspot-create-properties.mjs --dry-run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@google/generative-ai": "^0.24.1",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.9",
    "@react-pdf/renderer": "^4.5.1",
    "@sparticuz/chromium": "^149.0.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.107.0",
    "@types/mdx": "^2.0.14",
    "@vercel/analytics": "^2.0.1",
    "geist": "^1.7.2",
    "next": "15.5.19",
    "openai": "^6.44.0",
    "puppeteer-core": "^25.1.0",
    "react": "^18",
    "react-dom": "^18",
    "stripe": "^22.2.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@next/bundle-analyzer": "^16.2.9",
    "@playwright/test": "^1.61.0",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.3",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/ui": "^4.1.9",
    "eslint": "^10.5.0",
    "eslint-config-next": "^16.2.9",
    "jsdom": "^29.1.1",
    "marked": "^18.0.5",
    "postcss": "^8.5.15",
    "satori": "^0.26.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "postcss": "$postcss",
    "undici": "^7.28.0"
  }
}
