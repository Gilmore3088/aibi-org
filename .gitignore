# Local-only audit viewers (generated alongside their .md source)
docs/superpowers/design-system/ui-review.html

# scripts/auth-review.mjs output — re-generated on demand from the
# harness; raw JSON per-step logs are noisy and not useful to track.
/audit/auth-review/raw/

# Playwright
/playwright-report/
/test-results/
/.playwright/

# Private input stash — your notes, idea seeds, and raw research dumps
# (kept local; CHRONOLOGY/MASTER track the public-facing planning work)
# The folder-rule READMEs are tracked so future devs see the rules.
/Plans/_ideas/*
!/Plans/_ideas/README.md
/Plans/_assets/*
!/Plans/_assets/README.md
/Plans/aibi-docs/
/Plans/untitled folder/
/Plans/standards-aibi.zip

docs/reviews/lighthouse-*/

.superpowers/

# ─── Internal planning docs — keep local, never in the public repo ─────
# (2026-05-28: pulled from git index. Files preserved on local disk.)
#
# Anything operational / reference-grade stays tracked:
#   docs/README.md, docs/env-vars.md, docs/manual-verification-runbook.md,
#   docs/compliance/, docs/mailerlite-emails/, docs/mailerlite-automations-overview.html,
#   docs/stripe-products.md
#
# CHRONOLOGY.md, DECISIONS.md, CLAUDE.md stay tracked — they're load-bearing
# for AI-session continuity. Migrate later if you want a fully scrubbed repo.

# Top-level planning
/tasks/

# GSD planning state — internal, kept local (2026-06-01). Held the stale
# $79/Executive-Briefing funnel + legacy AiBI-P naming; untracked so the
# public repo carries only canonical pricing/terms. Files remain on disk.
/.planning/

