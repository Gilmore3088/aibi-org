/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AiBI-specific
.env
.env.local
.env.production
/.vscode

# Claude Code / MCP session state (local-only, never commit)
.claude/
.mcp.json

# Superpowers brainstorm session runtime state
.superpowers/brainstorm/

# Local-only audit viewers (generated alongside their .md source)
docs/superpowers/design-system/ui-review.html

# Playwright
/playwright-report/
/test-results/
/.playwright/

# Private input stash — your notes, idea seeds, and raw research dumps
# (kept local; CHRONOLOGY/MASTER track the public-facing planning work)
# The folder-rule READMEs are tracked so future devs see the rules.
/Plans/_ideas/*
!/Plans/_ideas/README.md
/Plans/_assets/*
!/Plans/_assets/README.md
/Plans/aibi-docs/
/Plans/untitled folder/
/Plans/standards-aibi.zip

docs/reviews/lighthouse-*/

# Content engine (Python) — venv, build artifacts, secrets, eval set
/content-engine/.venv/
/content-engine/.modal/
/content-engine/**/__pycache__/
/content-engine/**/*.pyc
/content-engine/**/*.egg-info/
/content-engine/.env
/content-engine/evals/scout_eval_set.jsonl
